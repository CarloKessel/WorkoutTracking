{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "FrontendUrl": ""
  },
  "ReverseProxy": {
    "Routes": {
      "read-route": {
        "ClusterId": "read-cluster",
        "Match": {
          "Path": "read-api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "write-route": {
        "ClusterId": "write-cluster",
        "Match": {
          "Path": "write-api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "read-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://readservice:5101"
          } // For load balancing
          //"destination2": {
          //  "Address": "http://readservice:5111"
          //},
          //"destination3": {
          //  "Address": "http://readservice:5121"
          //}
        }
      },
      "write-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://writeservice:5201"
          } // For load balancing
          //"destination2": {
          //  "Address": "http://writeservice:5211"
          //},
          //"destination3": {
          //  "Address": "http://writeservice:5221"
          //}
        }
      }
    }
  }
}
