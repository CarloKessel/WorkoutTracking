{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "",
        "ValidAudiences": [ "", "" ],
        "ValidIssuer": ""
      }
    }
  },
  "Frontend": {
    "FrontendUrl": ""
  },
  "ReverseProxy": {
    "Routes": {
      "read-route": {
        "ClusterId": "read-cluster",
        "AuthorizationPolicy": "RequireReadWorkoutPermissions",
        "Match": {
          "Path": "read-api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "read-api/{**catch-all}" },
          {
            "RequestHeader": "X-Api-Gateway-Key",
            "Append": ""
          }
        ]
      },
      "write-route": {
        "ClusterId": "write-cluster",
        "AuthorizationPolicy": "RequireWriteWorkoutPermissions",
        "Match": {
          "Path": "write-api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "write-api/{**catch-all}" },
          {
            "RequestHeader": "X-Api-Gateway-Key",
            "Append": ""
          }
        ]
      }
    },
    "Clusters": {
      "read-cluster": {
        "Destinations": {
          "destination1": {
            "Address": ""
          }
        }
      },
      "write-cluster": {
        "Destinations": {
          "destination1": {
            "Address": ""
          }
        }
      }
    }
  }
}
